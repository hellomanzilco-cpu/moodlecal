# Run npm run setup to create .env with fresh secret keys.
# Create a Telegram bot with @BotFather, then paste its token here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling

# Use your public HTTPS address before inviting students.
PUBLIC_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000

MOODLE_URL=https://moodle.uwed.uz
# Optional: local account inspection only. Never shared with other students.
MOODLE_USERNAME=
MOODLE_PASSWORD=
MOODLE_TOKEN=
DEFAULT_TIMEZONE=Asia/Tashkent
POLL_SECONDS=300
# Moodle change detection is event-driven; POLL_SECONDS is legacy retry/freshness configuration only.
# Share this generated event secret with UWED IT through a private channel.
MOODLE_EVENT_SECRET=
DATABASE_PATH=./data/moodle-calendar.sqlite

# Generated by setup. Keep this key with encrypted database backups.
ENCRYPTION_KEY=
# Generated by setup; required if TELEGRAM_MODE=webhook.
WEBHOOK_SECRET=
